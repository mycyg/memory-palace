{
  "hooks": {
    "SessionStart":[{"matcher":"*","hooks":[{"type":"command","command":"python3 -m eventmem.hooks.bridge start","timeout":10}]}],
    "PreToolUse":[{"matcher":"*","hooks":[{"type":"command","command":"python3 -m eventmem.hooks.bridge pre_action","timeout":10}]}],
    "PostToolUse":[{"matcher":"*","hooks":[{"type":"command","command":"python3 -m eventmem.hooks.bridge tool","timeout":10}]}],
    "UserPromptSubmit":[{"hooks":[{"type":"command","command":"python3 -m eventmem.hooks.bridge message","timeout":10}]}],
    "PreCompact":[{"hooks":[{"type":"command","command":"python3 -m eventmem.hooks.bridge compact","timeout":10}]}],
    "SessionEnd":[{"hooks":[{"type":"command","command":"python3 -m eventmem.hooks.bridge end","timeout":10}]}]
  }
}

# 复制为 .env 后填写；.env 已在 .gitignore，真实 key 不得写入任何入库文件。

# Anthropic 兼容端点的基址，默认 https://api.anthropic.com；换供应商时改这里（例如 DeepSeek 的 Anthropic 兼容端点）
EVENTMEM_BASE_URL=

# 端点的 API key，仅从环境变量读取，缺失时整理与抽取降级为纯规则
EVENTMEM_API_KEY=

# 整理与抽取使用的模型名，默认 claude-haiku-4-5-20251001；小模型足够
EVENTMEM_MODEL=

# 单次 LLM 请求超时秒数，可省略，默认 60
EVENTMEM_TIMEOUT_S=

flowchart TD
    A["Host cue or explicit request"] --> P["Scenario policy\nScope · world · valid time · known-at cutoff"]
    P --> F["Fast path\nExact cue · cached candidates · FTS5"]
    P --> D["Explicit deep path\nEmbedding · relation expansion · optional reranking"]
    F --> C["Candidate fusion"]
    D --> C
    C --> V["Recheck canonical SQLite state\nScope · revision · validity · deletion"]
    V --> R["Ranked evidence\nImportance remains separate from confirmation"]
    R --> B["Context budget selection\nConstraints · memory · predictions accounted separately"]
    B --> H{"Host context capability"}
    H -- "replace" --> RS["Resident set\nReplace the prior memory context"]
    H -- "append" --> CS["Cumulative cap + revision-aware dedup\nAfter cap: explicit reads only"]
    RS --> O["Bounded text + ids + source links + state\nFull events / document sections available by read"]
    CS --> O
    O --> FE["Feedback: displayed · read · adopted\nVerified · corrected · unknown"]
    CP["Compaction boundary"] --> CK["Save confirmed progress and open questions\nRestore a fresh bounded working set"]
    CK --> B
    V -. "filtered candidates and reasons" .-> LAB["Recall laboratory and temporal replay"]
    B -. "rank, cost and chosen context" .-> LAB

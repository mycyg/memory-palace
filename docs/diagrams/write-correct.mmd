  themeVariables:
    fontSize: 26px
---
flowchart TD
    A["Source envelope\nnamespace · key · version · scope · timestamp"] --> D{"Source identity exists?"}
    D -- "same hash" --> R["Return prior durable receipt"]
    D -- "different hash" --> C["Conflict: require a new version"]
    D -- "deleted identity" --> X["Reject reintroduction"]
    D -- "new" --> B["Save immutable content-addressed snapshot"]
    B --> T["SQLite transaction\nSource metadata + progress + unique jobs"]
    T --> ME["Mechanical stage\nObserved actions / explicit text / structured parsing"]
    T --> L["Model stage\nStructured proposals with exact evidence quotes"]
    L --> V["Candidate schema and evidence validation\nGenerated assertions retain uncertainty"]
    V --> CF["Conflict proposals\nReplace · coexist · refute · retract · unverified"]
    ME --> COMMIT
    CF --> COMMIT["Domain command transaction\nRevision check · source links · current state"]
    COMMIT --> IDX["FTS update · dirty dependencies · embedding job"]
    U["User correction\nExpected revision + stable command id"] --> COMMIT
    COMMIT --> HIST["Append revision history"]
    COMMIT --> INV["Invalidate cached views and derived conclusions\nRecheck pending contacts"]
    INV --> CURRENT["Current reads use the corrected state immediately"]
    DEL["Explicit deletion"] --> ERASE["Erase selected source content and dependent views\nTombstones prevent reconstruction"]
    FAIL["Model timeout / missing configuration"] --> RETRY["Keep receipt and mechanical progress\nRetry only unfinished model stage"]
    RETRY --> L

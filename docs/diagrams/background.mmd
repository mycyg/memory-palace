flowchart LR
    W["Committed source or revision"] --> DIRTY["Dirty records and dependencies"]
    DIRTY --> Q[("SQLite durable queue\nUnique key · dependencies · attempts")]
    Q --> LEASE["Claim lease + fencing token\nHeartbeat / crash recovery"]
    LEASE --> CONFIG{"Required parser or model configured?"}
    CONFIG -- "no" --> WAIT["Waiting configuration\nSource remains available"]
    WAIT --> Q
    CONFIG -- "yes" --> JOB["Parse / extract / embed\nSummarize / organize / rebuild"]
    JOB --> CHECK{"Lease still owned?\nJob still active?"}
    CHECK -- "no" --> DISCARD["Discard authoritative commit"]
    CHECK -- "yes" --> COMMIT["Transactional domain commit\nRecord revision + processing progress"]
    COMMIT --> INDEX["FTS / LanceDB derived views"]
    COMMIT --> TOPIC["Leiden candidate families\nPublish · merge · split · rollback"]
    TOPIC --> VOLUME["Narrative volumes and 3D layout\nEvidence-linked diary and self-narrative"]
    JOB -- "timeout / error" --> RETRY["Backoff or terminal failure\nInspectable error state"]
    RETRY --> Q
    INTERACT["Interactive request"] -. "defer new background claims" .-> LEASE
